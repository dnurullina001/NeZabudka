{
  "appId": "com.tedo.nezabudka",
  "productName": "НеЗабудка",
  "copyright": "Copyright © 2026 ТеДо",
  "directories": {
    "output": "release",
    "buildResources": "assets"
  },
  "files": [
    "dist/main.js",
    "package.json"
  ],
  "extraResources": [
    { "from": "dist/renderer", "to": "renderer", "filter": ["**/*"] },
    { "from": "dist/sql-wasm.wasm", "to": "sql-wasm.wasm" }
  ],
  "asar": true,
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] },
      { "target": "zip",  "arch": ["x64"] }
    ],
    "icon": "assets/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "НеЗабудка"
  }
}
